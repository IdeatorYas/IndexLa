# INDEXLA disaster-recovery configuration (names only — copy to VPS, never commit real values)
# Install on VPS: /root/.indexla-dr/config.env (chmod 600)

# Local staging directory on VPS (default: /var/backups/indexla)
# INDEXLA_DR_BACKUP_ROOT=/var/backups/indexla

# GPG symmetric passphrase file for encrypted .env backups (required for env backup)
# INDEXLA_DR_PASSPHRASE_FILE=/root/.indexla-dr/passphrase

# Off-server destination (at least one recommended)
# rsync over SSH:
# INDEXLA_DR_OFFSITE_RSYNC=backup-user@backup-host.example:/backups/indexla-vps/
# rclone remote (install rclone separately):
# INDEXLA_DR_OFFSITE_RCLONE=remote:indexla-dr
# scp target (uses same SSH key as rsync):
# INDEXLA_DR_OFFSITE_SCP=backup-user@backup-host.example:/backups/indexla-vps/

# Retention (days)
# INDEXLA_DR_DAILY_RETENTION_DAYS=7
# INDEXLA_DR_WEEKLY_RETENTION_DAYS=28

# Repository URLs for rebuild manifest (no secrets)
# INDEXLA_WEBSITE_REPO=https://github.com/IdeatorYas/IndexLa.git
# INDEXLA_APP_REPO=https://github.com/IdeatorYas/IndexlaApp.git
